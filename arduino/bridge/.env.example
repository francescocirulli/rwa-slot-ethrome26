# Same origin as the iPad, HTTPS outside local development.
APP_ORIGIN=http://localhost:3000
# Same random secret as apps/web SLOT_HARDWARE_TOKEN (at least 32 characters).
SLOT_HARDWARE_TOKEN=
# Arduino's LAN address shown on its LCD/USB serial. Never expose port 81 publicly.
ARDUINO_WS_URL=ws://192.168.1.100:81
