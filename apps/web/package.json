{
  "name": "rwa-slot",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": ">=22 <23"},
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/account.test.ts tests/welcome.test.ts tests/privy.test.ts tests/relay.test.ts tests/play-relay.test.ts tests/gas.test.ts tests/transactions.test.ts tests/admin.test.ts tests/wallet-authorization.test.ts tests/swaps.test.ts tests/backend-key.test.ts tests/hardware.test.ts",
    "test:browser": "playwright test",
    "test:chain": "tsx --test tests/slot-chain.test.ts"
  },
  "dependencies": {
    "@privy-io/node": "0.34.0",
    "@privy-io/react-auth": "3.42.0",
    "jose": "^6.2.12",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.56.0"
  },
  "overrides": {
    "axios@>=1.0.0 <2.0.0": "1.20.0",
    "ws@>=8.0.0 <9.0.0": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pngjs": "^6.0.5",
    "acorn": "^8.18.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
