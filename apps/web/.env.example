NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Required on Railway: exact public HTTPS origin, without trailing slash.
APP_ORIGIN=http://localhost:3000
# Optional dedicated Base mainnet RPC; public RPC is the default.
BASE_RPC_URL=https://mainnet.base.org
# Optional comma-separated RPC URLs tried in order when BASE_RPC_URL fails,
# rate-limits or rejects a bounded log request. Reads fall back automatically;
# the keeper still signs on the primary. Example:
# https://base-rpc.publicnode.com,https://mainnet.base.org
BASE_RPC_FALLBACK_URLS=

# Leave empty until the DigitalSlotMachine deployment on Base mainnet.
SLOT_CONTRACT_ADDRESS=
# Exact deployment block. Used for bounded, resumable event scans.
SLOT_DEPLOYMENT_BLOCK=
# Optional: maximum blocks per eth_getLogs call. Set it to the RPC provider's limit
# (for example 10 on Alchemy Free, 5 on QuickNode Discover). Default 2000.
SLOT_LOG_PAGE_BLOCKS=
# Optional: earliest block scanned for a player's spins and welcome grants. Defaults
# to SLOT_DEPLOYMENT_BLOCK. Raise it to skip old history on a range-capped RPC:
# rounds older than this block are not recovered or displayed.
SLOT_HISTORY_FROM_BLOCK=
# Optional: prize collection for minting, default is the deployed Base collection.
SLOT_PRIZE1155_ADDRESS=
# Dedicated backend EOA, 0x-prefixed 32-byte key. NEVER use NEXT_PUBLIC_.
# Needs Base ETH for gas and GAME_MANAGER_ROLE for startFreeSpin(player).
# REPLACE_ME (or empty) disables the keeper; it is not a usable private key.
SLOT_BACKEND_PRIVATE_KEY=REPLACE_ME
# User pays in the Privy dashboard: Base + USDC. Default is usdc.
# usdc = USDC gas first, fallback ETH only after a definite balance rejection.
# eth = native ETH only. Never charges the app's gas credits.
# Does not apply to the dedicated backend EOA (always uses ETH).
PRIVY_GAS_MODE=usdc

# Privy user ID of the shared admin wallet's owner (not an email/address).
# Sign in at /admin to copy it. Only this account can create the shared wallet
# and add/remove collaborators. Empty = setup screen, no admin wallet access.
ADMIN_OWNER_USER_ID=
# Stable external ID selecting the shared wallet in this Privy app.
# Empty preserves lucky_signal_shared_admin_v1 for existing deployments.
# Set a new unique ID ONLY to initialize a separate wallet (new address/funds).
# Changing the owner ID alone never transfers ownership. Keep this ID stable.
# Allowed: 1-128 letters, digits, underscores or hyphens.
ADMIN_WALLET_EXTERNAL_ID=

# Optional LI.FI API key, server-only. Public quotes work without a key.
LIFI_API_KEY=

# Optional physical cabinet. Same random 32+ character secret in arduino/.env.backend.
# Empty disables hardware routes; touch controls and offline demo still work.
SLOT_HARDWARE_TOKEN=

# Optional Arkiv seasons. One writer in this service.
ARKIV_ENABLED=false
ARKIV_PROJECT=wall-street-slot-ethrome26
# Optional with a signing key: its public address is derived automatically.
ARKIV_WRITER_ADDRESS=
# Default: separate Arkiv key. For explicit keeper reuse, leave this empty.
ARKIV_PRIVATE_KEY=
ARKIV_USE_SLOT_BACKEND_KEY=false
# Server-only API key, appended to both base URLs.
ARKIV_API_KEY=
# Base URLs: do not also embed a key when ARKIV_API_KEY is set.
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_WS_URL=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
# Immutable schedule origin (Arkiv block). Set explicitly before enabling.
ARKIV_SEASON_ANCHOR_BLOCK=
# 1,296,000 Arkiv blocks is approximately 30 days. Use 60 only for a two-minute demo.
ARKIV_SEASON_BLOCKS=1296000
ARKIV_HISTORY_DAYS=30
# First Base block to ingest; must be at or after SLOT_DEPLOYMENT_BLOCK.
ARKIV_BASE_FROM_BLOCK=

# ENSv2 beta on Ethereum Sepolia. Uses SLOT_BACKEND_PRIVATE_KEY (existing backend EOA).
# Empty registrar disables ENS UI/API writes without affecting login/wallets.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_REGISTRAR_ADDRESS=
ENS_SUBREGISTRY_ADDRESS=
ENS_DEPLOYMENT_BLOCK=
# Existing Base ENS vouchers (collection token ID 2) are permanently locked, not burned.
ENS_REDEMPTION_ADDRESS=
ENS_REDEMPTION_BLOCK=
